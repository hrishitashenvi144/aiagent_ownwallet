{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditagent.local/schemas/report.json",
  "title": "AuditReport",
  "description": "Ranked triage report generated for an audited Solidity contract.",
  "type": "object",
  "required": [
    "job_id",
    "timestamp",
    "scan_depth",
    "target_contract",
    "summary",
    "findings",
    "triage_notes"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scan_depth": {
      "type": "string",
      "enum": ["quick", "standard", "deep"]
    },
    "target_contract": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "risk_score",
        "total_critical",
        "total_high",
        "total_medium",
        "total_low",
        "total_informational"
      ],
      "properties": {
        "risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Composite danger score from 0 (clean) to 100 (critical vulnerabilities detected)"
        },
        "total_critical": { "type": "integer", "minimum": 0 },
        "total_high": { "type": "integer", "minimum": 0 },
        "total_medium": { "type": "integer", "minimum": 0 },
        "total_low": { "type": "integer", "minimum": 0 },
        "total_informational": { "type": "integer", "minimum": 0 },
        "total_verified": { "type": "integer", "minimum": 0, "description": "Count of findings with verified Foundry exploit PoCs" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.json"
      }
    },
    "triage_notes": {
      "type": "string",
      "description": "Executive summary and LLM synthesis explaining overall architecture risk"
    },
    "agent_execution_summary": {
      "type": "object",
      "properties": {
        "total_steps": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "total_cost_usd": { "type": "number" },
        "tools_executed": { "type": "array", "items": { "type": "string" } },
        "trace_available": { "type": "boolean" }
      }
    },
    "second_opinion": {
      "type": "object",
      "properties": {
        "reviewer_address": { "type": "string" },
        "escrow_id": { "type": "string" },
        "consensus_score": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "gas_report": {
      "type": "object",
      "properties": {
        "hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "function": { "type": "string" },
              "estimated_gas": { "type": "integer" },
              "suggestion": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}