# ==============================================================================
# AuditAgent Environment Variables Template
# Copy to .env and configure for local or testnet deployment
# NEVER COMMIT REAL PRIVATE KEYS OR MAINNET CREDENTIALS!
# ==============================================================================

# Network & RPC Settings (Base Sepolia)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# Testnet Tokens & Smart Contracts
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
AGENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REPUTATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Agent Wallets & Keys (TESTNET ONLY)
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SESSION_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# LLM Provider Configuration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=claude-3-5-sonnet-20241022

# Agent Core API Settings
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
DATABASE_URL=sqlite:///./auditagent.db
LOG_LEVEL=INFO
MOCK_PAYMENT_VERIFICATION=false

# Analysis Engine Sandbox Settings
DOCKER_SANDBOX_IMAGE=auditagent-analysis-sandbox:latest
ANALYSIS_TIMEOUT_SECONDS=180
MAX_CONTAINER_CPU=2.0
MAX_CONTAINER_MEM=2048m

# Next.js Dashboard Frontend
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_USE_MOCK=false
